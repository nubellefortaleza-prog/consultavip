# ============================
# Base app
# ============================
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/consultavip
JWT_SECRET=change-me
OWNER_OPEN_ID=

# ============================
# Auth (current Manus OAuth flow)
# ============================
# While auth migration is pending, keep these if you still use Manus OAuth.
VITE_APP_ID=
OAUTH_SERVER_URL=

# Supabase auth (new)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_AUTH_MODE=supabase
VITE_SUPABASE_AUTH_PROVIDER=google


# ============================
# AI provider (recommended: own OpenAI-compatible provider)
# ============================
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional compatibility aliases
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Legacy Manus fallback (to be removed)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gemini fallback (optional)
GEMINI_API_KEY=

# ============================
# Storage provider (recommended: S3/R2)
# ============================
STORAGE_PROVIDER=s3
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL_SECONDS=3600

# ============================
# Email SMTP
# ============================
SMTP_USER=
SMTP_PASS=

# ============================
# Frontend analytics
# ============================
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Maps proxy frontend config
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
